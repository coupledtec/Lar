    "1. Configurações → Dispositivos e conexões → Recursos remotos: marque \"Habilitar recursos remotos\"." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Settings → Devices & connections → Remote features: check \"Enable remote features\"."
          }
        }
      }
    },
    "1. Token pessoal" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Personal token"
          }
        }
      }
    },
    "2. Client ID e Client Secret" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Client ID and Client Secret"
          }
        }
      }
    },
    "2. Na mesma tela, em Preferências do app Xbox: \"Permitir conexões de qualquer dispositivo\"." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. On the same screen, under Xbox app preferences: \"Allow connections from any device\"."
          }
        }
      }
    },
    "3. Configurações → Geral → Opções de energia: escolha \"Suspensão\". Em \"Economia de energia\" o Xbox não liga pelo Lar." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Settings → General → Power options: choose \"Sleep\". In \"Energy saving\" the Xbox can't be turned on from Lar."
          }
        }
      }
    },
    "3. Entrar e pegar o código" : {
      "localizations" : {
