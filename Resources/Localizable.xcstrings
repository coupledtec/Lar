    "O PS5 não respondeu em %@. Ele precisa estar ligado (fora do repouso) e na mesma rede." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PS5 didn't answer at %@. It must be on (out of rest mode) and on the same network."
          }
        }
      }
    },
    "O PS5 parou de responder" : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PS5 stopped responding"
          }
        }
      }
    },
    "O PS5 pediu a senha de acesso da conta. Informe-a em Ajustes → Jogos → PlayStation." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PS5 asked for the account's passcode. Enter it in Settings → Games → PlayStation."
          }
        }
      }
    },
    "O PS5 recusou a sessão%@. Pareie de novo em Ajustes → Jogos." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The PS5 refused the session%@. Pair again in Settings → Games."
          }
