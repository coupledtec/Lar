<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Widgets must be sandboxed; they only read the list the app leaves in the shared folder. The group
	     (TEAMID.com.coupled.lar) is added by scripts/build-app.sh from the signing certificate. -->
	<key>com.apple.security.app-sandbox</key>
	<true/>
</dict>
</plist>
